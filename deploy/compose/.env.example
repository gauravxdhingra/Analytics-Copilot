# Laptop-only configuration. `make env` copies this to .env (git-ignored) and replaces every
# "change-me" with a fresh random secret. Never commit real values, and never reuse these anywhere
# but a laptop.
KEYCLOAK_ADMIN_PASSWORD=change-me
DEMO_USER_PASSWORD=change-me
POSTGRES_OWNER_PASSWORD=change-me
QUERY_DB_PASSWORD=change-me
GATEWAY_DB_PASSWORD=change-me
DRAFTS_DB_PASSWORD=change-me
APPROVAL_DB_PASSWORD=change-me
BFF_CLIENT_SECRET=change-me
ORCHESTRATOR_CLIENT_SECRET=change-me
MCP_ANALYTICS_CLIENT_SECRET=change-me
MCP_DRAFTS_CLIENT_SECRET=change-me
MODEL_PROVIDER=
LITELLM_BASE_URL=
LITELLM_API_KEY=
MODEL=
QUERY_API_CLIENT_SECRET=change-me
APPROVAL_CLIENT_SECRET=change-me
